#include <iostream>
using namespace std;

const int SIZE = 9;

// Function to display the Sudoku grid
void displayGrid(int grid[SIZE][SIZE])
{
    cout << "\n-------------------------\n";

    for (int row = 0; row < SIZE; row++)
    {
        for (int col = 0; col < SIZE; col++)
        {
            if (col % 3 == 0)
                cout << "| ";

            cout << grid[row][col] << " ";
        }

        cout << "|\n";

        if ((row + 1) % 3 == 0)
            cout << "-------------------------\n";
    }
}

// Check if a number can be placed in a particular cell
bool isSafe(int grid[SIZE][SIZE], int row, int col, int num)
{
    // Check the row
    for (int x = 0; x < SIZE; x++)
    {
        if (grid[row][x] == num)
            return false;
    }

    // Check the column
    for (int x = 0; x < SIZE; x++)
    {
        if (grid[x][col] == num)
            return false;
    }

    // Check the 3x3 subgrid
    int startRow = row - row % 3;
    int startCol = col - col % 3;

    for (int i = 0; i < 3; i++)
    {
        for (int j = 0; j < 3; j++)
        {
            if (grid[startRow + i][startCol + j] == num)
                return false;
        }
    }

    return true;
}

// Backtracking function to solve the Sudoku
bool solveSudoku(int grid[SIZE][SIZE])
{
    int row = -1;
    int col = -1;
    bool emptyCell = false;

    // Find an empty cell
    for (int i = 0; i < SIZE; i++)
    {
        for (int j = 0; j < SIZE; j++)
        {
            if (grid[i][j] == 0)
            {
                row = i;
                col = j;
                emptyCell = true;
                break;
            }
        }

        if (emptyCell)
            break;
    }

    // If there is no empty cell, Sudoku is solved
    if (!emptyCell)
        return true;

    // Try numbers from 1 to 9
    for (int num = 1; num <= 9; num++)
    {
        if (isSafe(grid, row, col, num))
        {
            // Place the number
            grid[row][col] = num;

            // Recursively solve the remaining cells
            if (solveSudoku(grid))
                return true;

            // Backtrack if the number does not lead to a solution
            grid[row][col] = 0;
        }
    }

    return false;
}

int main()
{
    int grid[SIZE][SIZE];

    cout << "Enter the Sudoku puzzle.\n";
    cout << "Use 0 for empty cells.\n\n";

    // Input the Sudoku grid
    for (int i = 0; i < SIZE; i++)
    {
        for (int j = 0; j < SIZE; j++)
        {
            cin >> grid[i][j];
        }
    }

    cout << "\n========== ORIGINAL SUDOKU ==========\n";
    displayGrid(grid);

    // Solve the Sudoku
    if (solveSudoku(grid))
    {
        cout << "\n========== SOLVED SUDOKU ==========\n";
        displayGrid(grid);
    }
    else
    {
        cout << "\nNo solution exists for this Sudoku puzzle.\n";
    }

    return 0;
}